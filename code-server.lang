[zh-cn]
name = "code-server 网页版 VS Code"
auth = "ericbyz"
descript = "在 NAS 上运行 VS Code,局域网内任意浏览器即可打开(上游 coder/code-server,自包含运行时,无需系统 Node)。预配置 18225 端口与密码认证,安装时自动生成密码并保存于 /etc/code-server/config.yaml。适合远程改配置、写脚本、轻量开发。"
note = "1. 将上游 coder/code-server 封装为 TOS 应用中心应用。"

[zh-hk]
name = "code-server 網頁版 VS Code"
auth = "ericbyz"
descript = "在 NAS 上運行 VS Code,局域網內任意瀏覽器即可打開(上游 coder/code-server,自包含運行時,無需系統 Node)。預配置 18225 端口與密碼認證,安裝時自動生成密碼並保存於 /etc/code-server/config.yaml。適合遠程改配置、寫腳本、輕量開發。"
note = "1. 将上游 coder/code-server 封装为 TOS 应用中心应用。"

[en-us]
name = "code-server"
auth = "ericbyz"
descript = "Run VS Code on the TNAS and open it from any browser on the LAN (upstream coder/code-server, self-contained with its own Node runtime). Preconfigured on port 18225 with password authentication; the generated password is shown at install time and kept in /etc/code-server/config.yaml."
note = "1. Repackaged upstream coder/code-server for the TOS App Center."

[ko-kr]
name = "code-server"
auth = "ericbyz"
descript = "NAS에서 VS Code를 실행하고 LAN의 모든 브라우저에서 여는 code-server입니다(업스트림 coder/code-server, 자체 Node 런타임 포함). 포트 18225과 비밀번호 인증이 사전 구성되며, 생성된 비밀번호는 /etc/code-server/config.yaml에 저장됩니다."
note = "1. Repackaged upstream coder/code-server for the TOS App Center."

