#!/bin/bash
set -e
APPID="code-server"
if [ "$1" = "purge" ]; then
    id -u "${APPID}" >/dev/null 2>&1 && userdel "${APPID}" 2>/dev/null || true
    rm -rf /var/lib/code-server /var/log/code-server /usr/local/code-server /etc/code-server 2>/dev/null || true
    rm -f /etc/systemd/system/code-server.service 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
fi
exit 0
