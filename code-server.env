# code-server service environment (sourced by systemd EnvironmentFile)

# Web listen port of record (config.ini open_path points here);
# the bind address itself lives in /etc/code-server/config.yaml
CODESERVER_PORT=18225

# Config file (bind address / auth / password)
CODESERVER_CONFIG=/etc/code-server/config.yaml

# User data dir (extensions, state) and logs
CODESERVER_DATA_DIR=/var/lib/code-server
